<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Desafio2DSML" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>

        <!-- Colores Secundarios y Acentos (Elimina el morado) -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/background_dark</item>
        <item name="colorSecondaryContainer">@color/primary_dark</item>
        <item name="colorOnSecondaryContainer">@color/text_white</item>

        <!-- Fondos de Pantalla y Barras -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.Desafio2DSML" parent="Base.Theme.Desafio2DSML" />
</resources>